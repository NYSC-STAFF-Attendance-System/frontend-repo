# Mock data is the default. Set to false to call the Django API instead.
NEXT_PUBLIC_USE_MOCK_API=true

# Only read when the flag above is false. The live backend on Railway.
# Its CORS currently allows http://localhost:3000 only, so test against it
# with plain `yarn dev`, not --experimental-https.
NEXT_PUBLIC_API_BASE_URL=https://backend-repo-production-efc6.up.railway.app
